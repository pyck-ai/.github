{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "<path-to-pyck-github-checkout>/.claude/AGENTS.md"
  ],
  "model": "anthropic/claude-opus-4-7",
  "permission": {
    "external_directory": {
      "~/.config/opencode/agent/**": "allow",
      "<path-to-pyck-github-checkout>/**": "allow"
    }
  },
  "plugin": ["@ex-machina/opencode-anthropic-auth@1.8.0"],
  "agent": {
    "build": {
      "variant": "max"
    },
    "plan": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max"
    },
    "frontend-developer": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max"
    },
    "go-developer": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "clickhouse": {
      "type": "remote",
      "url": "https://diag-mcp.pyck.cloud/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer <YOUR_CLICKHOUSE_MCP_TOKEN>"
      }
    },
    "graphql": {
      "type": "remote",
      "url": "https://mcp.dev.pyck.cloud/mcp",
      "oauth": {
        "clientId": "364033156204019471",
        "scope": "openid profile email"
      },
      "headers": {
        "x-pyck-tenant-id": "all"
      }
    }
  }
}
